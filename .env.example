# 平台模型配置；访问远程模型时需显式启用。
AI_AGENT_MODEL=deepseek-flash
AI_AGENT_BASE_URL=https://api.deepseek.com
AI_AGENT_API_KEY=
AI_AGENT_ALLOW_REMOTE=false
AI_AGENT_MODEL_PROVIDER=auto
AI_AGENT_THINKING=enabled
AI_AGENT_LOCAL_PROJECT_SELECTION=false
AI_AGENT_MYSQL_ENABLED=false

# 旧示例使用的供应商配置。
BAILIAN_API_KEY=
MOONSHOT_API_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=
BAILIAN_CATEGORY_ID=
AMAP_API_KEY=
MYSQL_PASSWORD=

# 平台数据库工具使用受限账号；仅支持管理员登记的库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_READ_USER=agent_reader
MYSQL_READ_PASSWORD=
MYSQL_DATABASES=

# 可选 PostgreSQL；不配置时使用本地 SQLite。
# AI_AGENT_DATABASE_URL=postgresql+psycopg://user:password@localhost/ai_agent
